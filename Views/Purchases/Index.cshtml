@model List<TiendaOnline.Models.PurchaseProposal>
<h1>Órdenes de compra propuestas por el agente de stock</h1>
<p>El agente de stock (loop ReAct) corre cada noche sobre los productos con poco stock y deja aquí su propuesta. Un humano la aprueba o la rechaza.</p>
@if(Model.Count==0){<p><em>No hay propuestas todavía.</em></p>}
<table class="data"><tr><th>Fecha UTC</th><th>Producto</th><th>Stock</th><th>Propuesta</th><th>Estado</th><th></th></tr>
@foreach(var p in Model){
<tr>
 <td>@p.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
 <td>@p.ProductName (#@p.ProductId)</td>
 <td>@p.StockAlProponer</td>
 <td>@p.Propuesta<details><summary>Traza del agente</summary><pre style="white-space:pre-wrap">@p.Traza</pre></details></td>
 <td>@p.Estado</td>
 <td>@if(p.Estado=="PENDIENTE"){
  <form action="/admin/compras/decidir" method="post" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="key" value="@ViewBag.Key"/><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="aprobar" value="true"/><button class="btn">Aprobar</button></form>
  <form action="/admin/compras/decidir" method="post" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="key" value="@ViewBag.Key"/><input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="aprobar" value="false"/><button>Rechazar</button></form>
 }</td>
</tr>}
</table>

@{ ViewData["Title"] = "Soporte"; }
<h1>Chat de soporte (agente con RAG y guardrails)</h1>
<p>Pregunta sobre la garantía, devoluciones, tiempos de entrega, soporte o exclusiones de un producto.</p>

<form id="f">
    <label>Producto (id): <input type="number" id="productId" value="1" min="1" /></label><br />
    <label>Pregunta:<br /><input type="text" id="pregunta" size="60" placeholder="¿Cuánto dura la garantía?" /></label><br />
    <button type="submit">Preguntar</button>
</form>

<pre id="r" style="background:#f5f5f5;padding:10px;margin-top:10px;white-space:pre-wrap"></pre>

<script>
document.getElementById('f').addEventListener('submit', async (e) => {
    e.preventDefault();
    const out = document.getElementById('r');
    out.textContent = 'Consultando...';
    const body = new URLSearchParams();
    body.append('productId', document.getElementById('productId').value);
    body.append('pregunta', document.getElementById('pregunta').value);
    try {
        const res = await fetch('/support/ask', { method: 'POST', body });
        const j = await res.json();
        out.textContent =
            'Respuesta: ' + j.respuesta + '\n' +
            'Fuentes (secciones del SLA): ' + (j.fuentes && j.fuentes.length ? j.fuentes.join(', ') : '—') +
            (j.bloqueadoPor ? '\nBloqueado por guardrail: ' + j.bloqueadoPor : '');
    } catch (err) { out.textContent = 'Error: ' + err; }
});
</script>

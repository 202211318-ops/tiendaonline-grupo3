<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup><Compile Remove="Worker/**/*.cs" /><Compile Remove="tests/**" /><Compile Remove="lambdas/**" /><Compile Remove="lambdas-delivery/**" /><Compile Remove="mobile-delivery/**" /><Compile Remove="emulador/**" /><Content Remove="tests/**;lambdas/**;lambdas-delivery/**;mobile-delivery/**;emulador/**" /><None Remove="tests/**;lambdas/**;lambdas-delivery/**;mobile-delivery/**;emulador/**" /></ItemGroup>
  <!-- Modelo de embeddings (no está en git: se descarga con scripts/descargar-modelo.ps1). Se incluye en dotnet publish para EC2. -->
  <ItemGroup><None Include="ml-models/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <!-- Catalogo del Motor de IA (se copia al publicar; la key NO va aqui, va en Secrets Manager). -->
  <ItemGroup>
    <Content Update="Data\llm\modelos.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Data\llm\settings.local.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="3.7.400" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.401" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.400.35" />
    <!-- Fase 3: sin este paquete el SDK no puede usar el rol IAM del pod en EKS (IRSA, AssumeRoleWithWebIdentity) -->
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.400.35" />
    <PackageReference Include="AWSSDK.CloudWatch" Version="3.7.401" />
    <PackageReference Include="AWSSDK.EventBridge" Version="3.7.401" />
  </ItemGroup>
</Project>

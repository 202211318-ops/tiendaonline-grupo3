<?xml version="1.0" encoding="utf-8"?>
<!-- Blindaje del pipeline (fase 2, dependencia infectada): los paquetes SOLO pueden venir de nuget.org.
     Un paquete publicado en otra fuente (p. ej. un feed falso con "URPOnline.Agentes.Conectores") no se descarga. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
